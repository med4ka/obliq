# Salin file ini jadi .env lalu sesuaikan dengan lingkungan lokal.
# Role terbatas obliq_app (grant hanya ke obliq_db), BUKAN superuser postgres.
# Isi password sesuai yang dibuat saat CREATE ROLE.
DATABASE_URL=postgresql+psycopg://obliq_app:GANTI_PASSWORD@localhost:5432/obliq_db

# BPS WebAPI key -- hasil registrasi manual di webapi.bps.go.id/developer.
# BLOKIR WAF per 2026 (Support ID: 6575722619588719224), isi setelah akses terverifikasi.
BPS_API_KEY=