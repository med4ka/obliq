# Copy this file to .env and adjust it for the local environment.
# Restricted role obliq_app (granted access only to obliq_db), NOT the postgres superuser.
# Set the password to the one created during the CREATE ROLE step.
DATABASE_URL=postgresql+psycopg://obliq_app:GANTI_PASSWORD@localhost:5432/obliq_db

# BPS WebAPI key -- obtained via manual registration at webapi.bps.go.id/developer.
