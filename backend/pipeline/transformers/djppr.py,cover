> """DJPPR auction results -> bonds + yield_observations transformer.
  
> WHAT it produces: from one validated auction (date + several SUN series), two
> internal records per series:
>   - a `Bond` (instrument metadata: code, coupon, maturity, tenor) -- created
>     once per series, reused across auctions; and
>   - a `YieldObservation` (that series' weighted-average yield ON the auction
>     date).
  
> WHY one auction yields MANY rows: DJPPR auctions are multi-tranche -- on a
> single date the government auctions several series (SPN short tenors plus FR
> benchmarks), each with its own winning yield. So a single page with N series
> produces N `yield_observations` rows sharing one observation_date.
  
> WHY the transformer merges already-seen bonds: the same series (e.g. FR0108)
> is re-auctioned every several weeks. bonds.code has a UNIQUE constraint, so the
> same code must map to the same bond row -- the transformer emits one Bond
> record per distinct series CODE and lets storage upsert it (idempotent).
> ``tenor_years` is computed from maturity vs the auction date; issue_date stays
> None because the auction results do not disclose the original issuance date of
> a reopened series (SYSTEM.md 1: never fabricate).
> """
> from __future__ import annotations
  
> import logging
> from dataclasses import dataclass
> from datetime import date
> from decimal import Decimal
  
> from pipeline.validators.djppr import DjpprAuction, DjpprSeries
  
> logger = logging.getLogger(__name__)
  
> DAYS_PER_YEAR = Decimal("365.25")
  
  
> @dataclass(frozen=True)
> class BondRecord:
>     """Normalized bond metadata, ready for upsert into `bonds`."""
  
>     code: str
>     name: str
>     type: str  # SCHEMA.md: government / corporate / sukuk_*
>     coupon_rate: Decimal | None  # None = zero-coupon (SPN)
>     maturity_date: date | None
>     tenor_years: Decimal | None
  
  
> @dataclass(frozen=True)
> class YieldObservationRecord:
>     """One normalized yield observation, ready for upsert."""
  
>     bond_code: str  # resolved to bond_id by storage
>     observation_date: date
>     yield_value: Decimal  # percent
>     source: str = "DJPPR"
  
  
> def _name_for_code(code: str) -> str:
>     """Human-readable name for a SUN series code.
  
>     SPN = Surat Perbendaharaan Negara (Treasury bills, short-tenor);
>     FR  = Fixed-Rate government notes (long-tenor benchmarks).
>     The auction page does not give a richer name, so we derive it from the code.
>     """
>     return f"SUN {code}"
  
  
> def _tenor_years(maturity: date, reference: date) -> Decimal:
>     """Rough tenor in years from the auction date to maturity (Decimal)."""
>     if maturity <= reference:
!         return Decimal("0")
>     days = (maturity - reference).days
>     return (Decimal(days) / DAYS_PER_YEAR).quantize(Decimal("0.01"))
  
  
> def transform(auctions: list[DjpprAuction]) -> dict[str, list]:
>     """Normalize validated auctions into {'bonds': [...], 'yield_obs': [...]}.
  
>     Exactly one BondRecord per distinct series code across all auctions, and
>     one YieldObservationRecord per (series, auction_date).
>     """
>     bonds_by_code: dict[str, BondRecord] = {}
>     yield_obs: list[YieldObservationRecord] = []
  
>     for auction in auctions:
>         for series in auction.series:
>             if series.weighted_yield is None:
                  # Not awarded ("-"): the series was offered but won no bids.
                  # No yield exists to record -- skip instrument + observation,
                  # we must never fabricate a yield (SYSTEM.md 1). Already logged
                  # by the validator; do not double-log per series here.
>                 continue
>             bond = _to_bond(series, auction.auction_date)
              # First occurrence defines the instrument; later auctions of the
              # same code must not contradict it (storage upsert is idempotent).
>             existing = bonds_by_code.get(series.code)
>             if existing is None:
>                 bonds_by_code[series.code] = bond
>             elif bond.maturity_date != existing.maturity_date:
!                 logger.warning(
!                     "Seri %s: maturity %s (auction %s) berbeda dari record sebelumnya %s -- "
!                     "record pertama dipertahankan",
!                     series.code, bond.maturity_date, auction.auction_date,
!                     existing.maturity_date,
!                 )
>             yield_obs.append(
>                 YieldObservationRecord(
>                     bond_code=series.code,
>                     observation_date=auction.auction_date,
>                     yield_value=series.weighted_yield,
>                 )
>             )
  
>     result = {
>         "bonds": sorted(bonds_by_code.values(), key=lambda b: b.code),
>         "yield_obs": yield_obs,
>     }
>     logger.info(
>         "DJPPR transform: %d bonds (distinct series), %d yield observations",
>         len(result["bonds"]), len(result["yield_obs"]),
>     )
>     return result
  
  
> def _to_bond(series: DjpprSeries, auction_date: date) -> BondRecord:
>     tenor = _tenor_years(series.maturity_date, auction_date)
>     return BondRecord(
>         code=series.code,
>         name=_name_for_code(series.code),
>         type="government",
>         coupon_rate=series.coupon_rate,
>         maturity_date=series.maturity_date,
>         tenor_years=tenor,
>     )
