!             continue  # not an ordinal data row (e.g. trailing notes)
>         parsed.append(
>             BiRow(no=cells[0].strip(), date_raw=cells[1].strip(), value_raw=cells[2].strip())
>         )
  
>     return BiSpreadsheet(
>         indicator_type=indicator_type,
>         header=header,
>         rows=parsed,
