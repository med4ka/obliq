!         return []
>     root = ET.fromstring(xlsx.read("xl/sharedStrings.xml"))
>     strings: list[str] = []
>     for si in root.iter(_XLSX_NS + "si"):
>         strings.append("".join(t.text or "" for t in si.iter(_XLSX_NS + "t")))
>     return strings
  
  
> def _cell_text(cell: ET.Element, shared: list[str]) -> str:
